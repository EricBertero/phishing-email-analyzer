<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Phishing report: {{ level_label }} ({{ score }}/100)</title>
{#- Deliberately plain CSS: the same template is rendered to PDF by xhtml2pdf, which
    supports blocks and tables but not flexbox, grid or CSS variables, so colours are the
    ebertero-brand palette's hex values (light roles: this is a printable document).
    The @font-face block is for the browser view only; render_pdf() strips it, and the PDF
    uses Helvetica, which every PDF reader has. -#}
<style>
  /* screen-fonts:start */
  @font-face { font-family: "Geist"; font-weight: 100 900; font-display: swap;
               src: url("/static/fonts/geist-latin.woff2") format("woff2"); }
  @font-face { font-family: "Geist Mono"; font-weight: 100 900; font-display: swap;
               src: url("/static/fonts/geist-mono-latin.woff2") format("woff2"); }
  /* screen-fonts:end */
  @page { size: a4; margin: 1.6cm 1.4cm; }
  body { font-family: "Geist", Helvetica, Arial, sans-serif; font-size: 10pt; color: #0a0a0a;
         line-height: 1.55; margin: 0; background: #ffffff; }
  .page { max-width: 860px; margin: 0 auto; padding: 32px 24px; }
  .rule { width: 64px; height: 4px; background: #14746f; margin: 0 0 18px 0; }
  h1 { font-size: 20pt; font-weight: 600; letter-spacing: -0.03em; line-height: 1.2; margin: 4px 0 8px 0; }
  h2 { font-size: 12.5pt; font-weight: 600; letter-spacing: -0.02em; margin: 26px 0 8px 0;
       padding-bottom: 4px; border-bottom: 1px solid #d4d4d8; -pdf-keep-with-next: true; }
  a { color: #14746f; }
  .muted { color: #52525b; }
  .small { font-size: 8.5pt; }
  .label { font-size: 7.5pt; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase;
           color: #14746f; }
  .badge { display: inline-block; padding: 3px 12px; border-radius: 999px; font-weight: 600;
           font-size: 9pt; color: #ffffff; }
  .clean, .low { background: #3f3f46; }
  .suspicious, .high, .critical { background: #b91c1c; }
  table { width: 100%; border-collapse: collapse; margin: 4px 0; }
  th, td { text-align: left; vertical-align: top; padding: 5px 6px;
           border-bottom: 1px solid #e4e4e7; }
  th { font-size: 8.5pt; font-weight: 600; color: #52525b; border-bottom: 1px solid #d4d4d8; }
  td.num, th.num { text-align: right; white-space: nowrap; width: 48px; padding-right: 12px; }
  td.key { width: 150px; color: #52525b; }
  .mono { font-family: "Geist Mono", Courier, monospace; font-size: 8.5pt; word-wrap: break-word; }
  .force { color: #b91c1c; font-weight: bold; }
  .box { border: 1px solid #d4d4d8; border-radius: 12px; padding: 12px 14px; margin: 6px 0;
         background: #f4f4f5; }
  ul { margin: 4px 0 4px 18px; padding: 0; }
  li { margin: 3px 0; }
  .footer { margin-top: 32px; padding-top: 8px; border-top: 1px solid #d4d4d8; }
</style>
</head>
<body>
<div class="page">

<div class="rule"></div>
<p class="muted small">Phishing Email Analyzer &middot; incident report &middot; generated {{ generated_at }}</p>
<h1>{{ subject or "(no subject)" }}</h1>
<p>
  <span class="badge {{ level }}">{{ level_label }}</span>
  &nbsp;<strong>{{ score }}/100</strong>
  {% if partial %}<span class="muted">&nbsp;(some checks were unavailable; the verdict may still change)</span>{% endif %}
</p>

<table>
  <tr><td class="key">From</td><td>{{ from_display or "" }} <span class="mono">{{ from_addr }}</span></td></tr>
  {% if forwarded_from %}<tr><td class="key">Originally from</td><td><span class="mono">{{ forwarded_from }}</span> (forwarded message)</td></tr>{% endif %}
  {% if reply_to %}<tr><td class="key">Reply-To</td><td class="mono">{{ reply_to }}</td></tr>{% endif %}
  {% if return_path %}<tr><td class="key">Return-Path</td><td class="mono">{{ return_path }}</td></tr>{% endif %}
  <tr><td class="key">To</td><td class="mono">{{ to }}</td></tr>
  <tr><td class="key">Sent</td><td>{{ sent_at or "unknown" }}</td></tr>
  {% if sender_ip %}<tr><td class="key">Sending server</td><td class="mono">{{ sender_ip }}{% if sender_rdns %} ({{ sender_rdns }}){% endif %}</td></tr>{% endif %}
  {% if message_id %}<tr><td class="key">Message-ID</td><td class="mono">{{ message_id }}</td></tr>{% endif %}
</table>

<h2>Summary</h2>
{% if ai %}
<div class="box">
  <p class="label">AI summary</p>
  <p><strong>{{ ai.headline }}</strong></p>
  <p>{{ ai.summary }}</p>
  <p class="muted small">Written by an AI model ({{ ai.model }}) from the findings below. It can make
  mistakes; the verdict comes from the deterministic checks, not from the model.</p>
</div>
{% else %}
<p>{{ fallback_summary }}</p>
{% if ai_note %}<p class="muted small">AI summary not included: {{ ai_note }}.</p>{% endif %}
{% endif %}

<h2>What to do</h2>
<ul>
{% for action in actions %}  <li>{{ action }}</li>
{% endfor %}</ul>

<h2>Findings</h2>
<table>
  <tr><th class="num">Pts</th><th>Finding</th><th>Signal</th></tr>
  {% for f in findings %}
  <tr>
    <td class="num">{% if f.force_critical %}<span class="force">CRIT</span>{% else %}{{ f.points }}{% endif %}</td>
    <td>{{ f.message }}</td>
    <td class="mono muted">{{ f.signal }}</td>
  </tr>
  {% endfor %}
</table>
{% if info_findings %}
<p class="muted small">Other checks: {% for f in info_findings %}{{ f.message }}{% if not loop.last %} &middot; {% endif %}{% endfor %}</p>
{% endif %}

<h2>Indicators of compromise</h2>
<p class="muted small">Links and domains are defanged (<span class="mono">hxxps</span>, <span class="mono">[.]</span>) so they cannot be opened by accident.</p>
<table>
  {% if ioc_domains %}<tr><td class="key">Domains</td><td class="mono">{{ ioc_domains | join(", ") }}</td></tr>{% endif %}
  {% if sender_ip %}<tr><td class="key">IP address</td><td class="mono">{{ sender_ip_defanged }}</td></tr>{% endif %}
  {% if urls %}<tr><td class="key">Links ({{ urls | length }})</td><td class="mono">{% for u in urls %}{{ u }}<br>{% endfor %}{% if urls_truncated %}... and {{ urls_truncated }} more{% endif %}</td></tr>{% endif %}
</table>

{% if attachments %}
<h2>Attachments</h2>
<table>
  <tr><th>File</th><th>Type</th><th>Size</th><th>SHA-256</th></tr>
  {% for a in attachments %}
  <tr><td>{{ a.filename or "(unnamed)" }}</td><td class="mono">{{ a.content_type }}</td><td>{{ a.size_kb }} KB</td><td class="mono">{{ a.sha256 }}</td></tr>
  {% endfor %}
</table>
{% endif %}

{% if auth %}
<h2>Email authentication</h2>
<p class="mono">{{ auth }}</p>
{% endif %}

{% if hops %}
<h2>Delivery path</h2>
<p class="muted small">Newest first. Only the first hop was recorded by your own mail provider; the rest could be forged.</p>
<table>
  <tr><th>From (as announced)</th><th>Connecting server</th><th>Received by</th></tr>
  {% for h in hops %}
  <tr><td class="mono">{{ h.from_helo or "" }}</td><td class="mono">{{ h.from_ip or "" }}{% if h.from_rdns %} ({{ h.from_rdns }}){% endif %}</td><td class="mono">{{ h.by_host or "" }}</td></tr>
  {% endfor %}
</table>
{% endif %}

<p class="footer muted small">Phishing Email Analyzer {{ version }} &middot; {{ provider }}:{{ provider_id }}.
Scores come from rule-based checks and threat-intelligence lookups; a Clean verdict is not a guarantee.</p>
</div>
</body>
</html>
