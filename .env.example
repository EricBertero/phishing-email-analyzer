# Copy to .env and fill in the keys you have. Every integration is optional:
# a missing key disables that check instead of failing the scan.

# https://auth.abuse.ch/ — URLhaus Auth-Key
PHISH_URLHAUS_AUTH_KEY=

# https://www.virustotal.com/gui/my-apikey
PHISH_VIRUSTOTAL_API_KEY=

# https://www.hybrid-analysis.com/my-account?tab=%23api-key-tab
PHISH_HYBRID_ANALYSIS_API_KEY=

# https://www.abuseipdb.com/account/api
PHISH_ABUSEIPDB_API_KEY=

# https://www.spamhaus.com/free-trial/sign-up-for-a-free-data-query-service-account/
PHISH_SPAMHAUS_DQS_KEY=

# https://console.anthropic.com/ — used only for Critical-case report summaries
ANTHROPIC_API_KEY=
